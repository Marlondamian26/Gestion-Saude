# ============================================================
# Gestão Saúde — Environment Variables Template
# Copiar a .env y rellenar con valores reales.
# NUNCA commitear .env con SECRET_KEY real.
# ============================================================

# — Django —
SECRET_KEY=changeme-to-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# — Database —
DATABASE_URL=postgres://user:password@localhost:5432/gestion_salud

# — Cache (Redis opcional en dev) —
# Si no se setea REDIS_URL, usa LocMemCache (solo dev).
REDIS_URL=redis://localhost:6379/0

# — Email / Notificaciones —
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
RESEND_API_KEY=

# — WhatsApp / SMS (Twilio) —
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# — Sentry (opcional) —
SENTRY_DSN=

# — Render —
RENDER_GIT_COMMIT=local-dev

# — Frontend —
# En CI, setear VITE_API_URL a la URL del backend
