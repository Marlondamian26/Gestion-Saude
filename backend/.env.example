# Backend environment template. Keep real credentials in an untracked .env file.
SECRET_KEY=replace-with-a-random-local-development-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_URL=postgresql://localhost:5432/gestion_saude
REDIS_URL=

# Media storage: filesystem for local development; s3 for configured Supabase Storage.
MEDIA_STORAGE=filesystem
SUPABASE_STORAGE_BUCKET=gestion-saude-media
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
